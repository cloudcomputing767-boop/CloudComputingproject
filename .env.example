# ===========================================================================
# Environment variables used in PRODUCTION (Render).
# Copy the names - never commit the real values.
#
# In ASP.NET Core a double underscore "__" means a nested setting, so
# ConnectionStrings__DefaultConnection fills in ConnectionStrings:DefaultConnection.
# ===========================================================================

# --- Cloud database (Neon PostgreSQL) -------------------------------------
# Paste the connection string that Neon gives you on its dashboard.
# Both of these formats work:
#   postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
#   Host=ep-xxx.eu-central-1.aws.neon.tech;Database=neondb;Username=user;Password=xxx;SSL Mode=Require
ConnectionStrings__DefaultConnection=

# --- Token signing key ----------------------------------------------------
# Any long random text (at least 32 characters). Generate a new one for
# production - do not reuse the local development key.
Jwt__Key=
Jwt__Issuer=ResourceBookingApi
Jwt__ExpiryHours=8

# --- Which frontend is allowed to call the API (CORS) ---------------------
# Index 0, 1, 2 ... one line per allowed origin.
Cors__AllowedOrigins__0=https://your-frontend-url.example.com

# --- The admin account created on first start -----------------------------
Seed__AdminName=System Administrator
Seed__AdminEmail=admin@college.com
Seed__AdminPassword=

# --- Set automatically by Render, listed here only for reference ----------
# PORT=10000
